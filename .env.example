# This build is not production-ready. Explicitly opt in for development only.
ALLOW_UNSAFE_DEVELOPMENT=1
# Never commit real secrets. Node 22.5+ is required.
BOT_TOKEN=
OWNER_ID=
ADMIN_IDS=
CHANNEL_ID=
CHANNEL_URL=
OWNER_USERNAME=
SUPPORT_USERNAME=
PAYMENT_QR_FILE_ID=
CURRENCY=USD
RESERVATION_MINUTES=15
# Local development only; production requires a durable POSIX filesystem.
DATABASE_PATH=./data/marketplace.db
BACKUP_DIR=./data/backups
# Gradio HTTP Basic Auth, mandatory. Use a long unique password.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
PORT=7860
