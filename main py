# broadcast flow
@bot.message_handler(commands=['broadcast'])
def cmd_broadcast(message):
    if not is_admin(message.from_user.id):
        return
    state['broadcast_wait'] = message.from_user.id
    _save_json(STATE_FILE, state)
    bot.reply_to(message, "✍️ Send the broadcast message now.")

@bot.message_handler(func=lambda m: state.get('broadcast_wait') == m.from_user.id)
def on_broadcast_text(message):
    if not is_admin(message.from_user.id):
        return
    state.pop('broadcast_wait', None)
    _save_json(STATE_FILE, state)
    text = message.text or ""
    sent = 0
    for uid in list(users):
        try:
            bot.send_message(uid, text)
            sent += 1
        except Exception:
            pass
    bot.reply_to(message, f"📢 Broadcast sent to {sent} users")

@bot.message_handler(commands=['users'])
def cmd_users(message):
    if not is_admin(message.from_user.id):
        return
    lst = list(users)
    preview = "\n".join(str(u) for u in lst[:50])
    more = "" if len(lst) <= 50 else f"\n... and {len(lst)-50} more"
    bot.reply_to(message, f"👥 Total users: {len(lst)}\n{preview}{more}")

@bot.message_handler(commands=['stats'])
def cmd_stats(message):
    if not is_admin(message.from_user.id):
        return
    cpu = psutil.cpu_percent(interval=0.6)
    mem = psutil.virtual_memory()
    running = len(processes)
    bot.reply_to(message, (
        f"📊 System Stats\nCPU: {cpu}%\n"
        f"RAM: {mem.used//(1024*1024)} MB / {mem.total//(1024*1024)} MB\n"
        f"Running Bots: {running}\n"
        f"Total Users: {len(users)}"
    ))

@bot.message_handler(commands=['ban'])
def cmd_ban(message):
    if not is_admin(message.from_user.id):
        return
    state['ban_wait'] = message.from_user.id
    _save_json(STATE_FILE, state)
    bot.reply_to(message, "🔒 Send the user ID to ban.")

@bot.message_handler(func=lambda m: state.get('ban_wait') == m.from_user.id)
def on_ban_input(message):
    if not is_admin(message.from_user.id):
        return
    state.pop('ban_wait', None)
    _save_json(STATE_FILE, state)
    try:
        uid = int(message.text.strip())
        banlist.add(uid)
        _save_json(BANS_FILE, list(banlist))
        bot.reply_to(message, f"✅ Unbanned {uid}")
    except Exception:
        bot.reply_to(message, "⚠️ Invalid user ID")

