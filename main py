import os, json, subprocess, threading, signal, zipfile, shutil, time
from pathlib import Path

from flask import Flask
import telebot
from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
import psutil

# ======================== CONFIG ========================
BOT_TOKEN = os.getenv("BOT_TOKEN", "PUT-YOUR-BOT-TOKEN-HERE")
ADMIN_IDS = {7905841795}  # add more admin IDs if needed
BASE_DIR = Path(__file__).parent
BOTS_DIR = BASE_DIR / "bots"
DATA_DIR = BASE_DIR / "data"
USERS_FILE = DATA_DIR / "users.json"
BANS_FILE = DATA_DIR / "bans.json"
STATE_FILE = DATA_DIR / "state.json"

os.makedirs(BOTS_DIR, exist_ok=True)
os.makedirs(DATA_DIR, exist_ok=True)

# ===================== PERSIST HELPERS ==================
def _load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default

def _save_json(path, obj):
    tmp = str(path) + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=2)
    os.replace(tmp, path)

users = set(_load_json(USERS_FILE, []))
banlist = set(_load_json(BANS_FILE, []))
state = _load_json(STATE_FILE, {})  # ephemeral admin flows etc.

# ===================== TELEGRAM BOT =====================
bot = telebot.TeleBot(BOT_TOKEN, parse_mode=None)

# running processes map: key = str(path), value = subprocess.Popen
processes = {}

# pending requirements upload: user_id -> target_folder_path(str)
pending_reqs = {}

# ===================== KEEPALIVE (Replit) ================
app = Flask(__name__)

@app.get("/")
def index():
    return "OK — Hosting Bot running"

def run_keepalive():
    app.run(host="0.0.0.0", port=int(os.getenv("PORT", 8080)))

threading.Thread(target=run_keepalive, daemon=True).start()

# ===================== UTILITIES ========================

def is_admin(uid: int) -> bool:
    return uid in ADMIN_IDS

def register_user(uid: int):
    if uid not in users:
        users.add(uid)
        _save_json(USERS_FILE, list(users))

def is_banned(uid: int) -> bool:
    return uid in banlist

def user_folder(uid: int) -> Path:
    p = BOTS_DIR / str(uid)
    p.mkdir(parents=True, exist_ok=True)
    return p

# returns (kind, run_cmd, workdir, main_path)
# kind: "py" | "js" | "zip"

def analyze_upload(saved_path: Path):
    name = saved_path.name
    lower = name.lower()
    if lower.endswith(".py"):
        return "py", ["python3", name], saved_path.parent, saved_path
    if lower.endswith(".js"):
        return "js", ["node", name], saved_path.parent, saved_path
    if lower.endswith(".zip"):
        # extract into folder named file-without-ext
        extract_root = saved_path.parent / (saved_path.stem + "_proj")
        if extract_root.exists():
            shutil.rmtree(extract_root)
        extract_root.mkdir(parents=True, exist_ok=True)
        with zipfile.ZipFile(saved_path, 'r') as z:
            z.extractall(extract_root)
        # find main.py
        main_path = None
        for root, dirs, files in os.walk(extract_root):
            if "main.py" in files:
                main_path = Path(root) / "main.py"
                break
        if main_path is None:
            raise RuntimeError("Zip extracted but main.py not found.")
        return "zip", ["python3", "main.py"], main_path.parent, main_path
    raise RuntimeError("Unsupported file type. Only .py, .js, .zip")


def pip_install_requirements(req_path: Path) -> (bool, str):
    try:
        cmd = ["pip", "install", "-r", str(req_path)]
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        return proc.returncode == 0, proc.stdout
    except Exception as e:
        return False, str(e)


def ensure_logfile(path: Path) -> Path:
    log_path = Path(str(path) + ".log")
    log_path.parent.mkdir(parents=True, exist_ok=True)
    if not log_path.exists():
        log_path.touch()
    return log_path


def start_process(key: str, run_cmd: list, workdir: Path, log_file: Path):
    # ensure node exists for js
    if run_cmd and run_cmd[0] == "node":
        try:
            subprocess.run(["node", "-v"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
        except Exception:
            raise RuntimeError("Node.js runtime not available on this Replit. Switch to a Node-enabled repl or install Node.")

    lf = open(log_file, "a", buffering=1)
    p = subprocess.Popen(run_cmd, cwd=str(workdir), stdout=lf, stderr=lf)
    processes[key] = {"p": p, "log": lf}


def stop_process(key: str):
    info = processes.get(key)
    if not info:
        return False
    p = info["p"]
    try:
        p.terminate()
        try:
            p.wait(timeout=6)
        except Exception:
            p.kill()
    finally:
        try:
            info["log"].close()
        except Exception:
            pass
        processes.pop(key, None)
    return True


def build_controls_keyboard(uid: int, file_key: str, back_to_menu=True, back_to_bot=False):
    kb = InlineKeyboardMarkup()
    kb.row(
        InlineKeyboardButton("▶️ Start", callback_data=f"start|{uid}|{file_key}"),
        InlineKeyboardButton("⏹ Stop", callback_data=f"stop|{uid}|{file_key}")
    )
    kb.row(
        InlineKeyboardButton("🔄 Restart", callback_data=f"restart|{uid}|{file_key}"),
        InlineKeyboardButton("📜 Logs", callback_data=f"logs|{uid}|{file_key}")
    )
    kb.row(
        InlineKeyboardButton("❌ Delete", callback_data=f"delete|{uid}|{file_key}")
    )
    if back_to_bot:
        kb.row(InlineKeyboardButton("🔙 Back to Bot Controls", callback_data=f"bot|{uid}|{file_key}"))
    if back_to_menu:
        kb.row(InlineKeyboardButton("🔙 Back to Menu", callback_data="menu"))
    return kb


def build_menu_keyboard(is_admin: bool):
    kb = InlineKeyboardMarkup()
    kb.row(InlineKeyboardButton("📂 My Bots", callback_data="mybots"))
    kb.row(InlineKeyboardButton("ℹ️ Help", callback_data="help"))
    # No admin button here (hidden)
    return kb


def build_mybots_keyboard(uid: int):
    kb = InlineKeyboardMarkup()
    folder = user_folder(uid)
    files = sorted([p for p in folder.iterdir() if p.is_file() and not p.name.endswith('.log')])
    if not files:
        kb.row(InlineKeyboardButton("🔙 Back to Menu", callback_data="menu"))
        return kb
    for p in files:
        kb.row(InlineKeyboardButton(f"🧩 Manage: {p.name}", callback_data=f"bot|{uid}|{p.name}"))
    kb.row(InlineKeyboardButton("🔙 Back to Menu", callback_data="menu"))
    return kb


def last_lines(path: Path, n=500):
    try:
        with open(path, 'r', encoding='utf-8', errors='ignore') as f:
            lines = f.readlines()
        return ''.join(lines[-n:])
    except Exception as e:
        return f"(log read error) {e}"


def chunk_and_send(chat_id: int, text: str, chunk_size=3500):
    # send in Markdown code blocks (```txt\n...\n```), chunk if needed
    if not text:
        bot.send_message(chat_id, "(empty log)")
        return
    start = 0
    while start < len(text):
        part = text[start:start+chunk_size]
        bot.send_message(chat_id, f"```txt\n{part}\n```", parse_mode="Markdown")
        start += chunk_size

