@bot.callback_query_handler(func=lambda c: c.data.startswith('bot|'))
def cb_bot(call):
    _, uid, fname = call.data.split('|', 2)
    uid = int(uid)
    folder = user_folder(uid)
    fpath = folder / fname
    if not fpath.exists():
        bot.answer_callback_query(call.id, "File missing")
        return
    status = "Running ✅" if str(fpath) in processes else "Stopped ⏹"
    bot.edit_message_text(f"🧩 {fname} — {status}", call.message.chat.id, call.message.message_id,
                          reply_markup=build_controls_keyboard(uid, fname))

@bot.callback_query_handler(func=lambda c: any(c.data.startswith(x) for x in ['start|','stop|','restart|','logs|','delete|']))
def cb_controls(call):
    action, uid, fname = call.data.split('|', 2)
    uid = int(uid)
    folder = user_folder(uid)
    fpath = folder / fname
    if not fpath.exists() and action != 'delete':
        bot.answer_callback_query(call.id, "File missing")
        return

    key = str(fpath)
    log_file = ensure_logfile(fpath)

    try:
        if action == 'start':
            if key in processes:
                bot.answer_callback_query(call.id, "Already running")
            else:
                kind, run_cmd, workdir, main_path = analyze_upload(fpath)
                start_process(key, run_cmd, workdir, log_file)
                bot.answer_callback_query(call.id, "Started ✅")
        elif action == 'stop':
            if stop_process(key):
                bot.answer_callback_query(call.id, "Stopped ⏹")
            else:
                bot.answer_callback_query(call.id, "Not running")
        elif action == 'restart':
            stop_process(key)
            kind, run_cmd, workdir, main_path = analyze_upload(fpath)
            start_process(key, run_cmd, workdir, log_file)
            bot.answer_callback_query(call.id, "Restarted 🔄")
        elif action == 'logs':
            txt = last_lines(log_file, 500)
            bot.answer_callback_query(call.id, "Logs")
            bot.send_message(call.message.chat.id, f"📜 Logs for {fpath.name} (last 500 lines):")
            chunk_and_send(call.message.chat.id, txt)
            # show back to bot controls
            bot.send_message(call.message.chat.id, "Controls:", reply_markup=build_controls_keyboard(uid, fname, back_to_menu=True, back_to_bot=False))
        elif action == 'delete':
            # stop if running
            stop_process(key)
            # remove file and log
            try:
                if fpath.exists():
                    if fpath.suffix.lower() == '.zip':
                        # remove extracted folder too
                        extract_root = folder / (fpath.stem + "_proj")
                        if extract_root.exists():
                            shutil.rmtree(extract_root, ignore_errors=True)
                    fpath.unlink()
                lf = Path(str(fpath) + ".log")
                if lf.exists():
                    lf.unlink()
                bot.answer_callback_query(call.id, "Deleted ❌")
            except Exception as e:
                bot.answer_callback_query(call.id, f"Delete failed: {e}")
        else:
            bot.answer_callback_query(call.id, "Unknown action")
    finally:
        pass

# =============== UPLOAD FLOW & REQUIREMENTS =============

@bot.message_handler(content_types=['document'])
def on_document(message):
    uid = message.from_user.id
    if is_banned(uid):
        return
    register_user(uid)

    # if we were waiting for requirements.txt
    if uid in pending_reqs:
        target_dir = Path(pending_reqs.pop(uid))
        # Save as requirements.txt into target_dir
        file_info = bot.get_file(message.document.file_id)
        file_bytes = bot.download_file(file_info.file_path)
        req_path = target_dir / 'requirements.txt'
        with open(req_path, 'wb') as f:
            f.write(file_bytes)
        ok, out = pip_install_requirements(req_path)
        if ok:
            bot.reply_to(message, "📦 requirements.txt installed successfully! Choose an action:",
                         reply_markup=build_controls_keyboard(uid, state.get(str(uid), {}).get('last_file',''), back_to_menu=True))
        else:
            bot.reply_to(message, f"⚠️ Install failed. You may still try to run.\n``````txt\n{out}\n``````",
                         parse_mode="Markdown",
                         reply_markup=build_controls_keyboard(uid, state.get(str(uid), {}).get('last_file',''), back_to_menu=True))
        _save_json(STATE_FILE, state)
        return

    # normal file upload (py/js/zip)
    folder = user_folder(uid)
    file_info = bot.get_file(message.document.file_id)
    file_bytes = bot.download_file(file_info.file_path)
    safe_name = message.document.file_name
    target = folder / safe_name
    with open(target, 'wb') as f:
        f.write(file_bytes)

    # analyze and set last file in state
    state.setdefault(str(uid), {})
    state[str(uid)]['last_file'] = target.name
    _save_json(STATE_FILE, state)

    # reply & ask for requirements or skip
    try:
        kind, run_cmd, workdir, main_path = analyze_upload(target)
        # if zip: check if requirements.txt exists in extracted project
        req_in_zip = False
        if kind == 'zip':
            rp = workdir / 'requirements.txt'
            if rp.exists():
                req_in_zip = True
                ok, out = pip_install_requirements(rp)
                if ok:
                    bot.reply_to(message, f"✅ Zip extracted and requirements installed.\nReady for actions on: `{target.name}`",
                                 parse_mode="Markdown",
                                 reply_markup=build_controls_keyboard(uid, target.name))
                    return
                else:
                    bot.reply_to(message, f"✅ Zip extracted but requirements install failed. You may retry via upload.\nChoose an action or upload a fixed requirements.txt.",
                                 reply_markup=build_controls_keyboard(uid, target.name))
                    return
        # non-zip or zip without reqs
        kb = InlineKeyboardMarkup()
        kb.row(InlineKeyboardButton("📤 Upload requirements.txt", callback_data=f"req|{uid}|{target.name}"))
        kb.row(InlineKeyboardButton("⏭️ Skip", callback_data=f"skipreq|{uid}|{target.name}"))
        kb.row(InlineKeyboardButton("🔙 Back to Menu", callback_data="menu"))
        bot.reply_to(message, f"✅ File saved: `{target}`\nIf your project needs dependencies, upload requirements.txt now or Skip.",
                     parse_mode="Markdown", reply_markup=kb)
    except Exception as e:
        bot.reply_to(message, f"⚠️ {e}")

@bot.callback_query_handler(func=lambda c: c.data.startswith('req|') or c.data.startswith('skipreq|'))
def cb_requirements(call):
    parts = call.data.split('|')
    action = parts[0]
    uid = int(parts[1])
    fname = parts[2]

    folder = user_folder(uid)
    fpath = folder / fname
    if not fpath.exists():
        bot.answer_callback_query(call.id, "File missing")
        return

    if action == 'req':
        pending_reqs[uid] = str(fpath.parent if fpath.suffix.lower() == '.zip' else fpath.parent)
        bot.answer_callback_query(call.id, "Send requirements.txt now")
        bot.send_message(call.message.chat.id, "📤 Please upload `requirements.txt` for this project.", parse_mode="Markdown")
    else:
        bot.answer_callback_query(call.id, "Skipped requirements")
        bot.edit_message_text("Choose an action:", call.message.chat.id, call.message.message_id,
                              reply_markup=build_controls_keyboard(uid, fname))

